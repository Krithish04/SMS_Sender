<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Gateway"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: "
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stopped"
        android:textColor="#FF0000"
        app:layout_constraintTop_toTopOf="@id/tvStatusLabel"
        app:layout_constraintStart_toEndOf="@id/tvStatusLabel" />

    <TextView
        android:id="@+id/tvIpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone IP: "
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatusLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0.0.0"
        app:layout_constraintTop_toTopOf="@id/tvIpLabel"
        app:layout_constraintStart_toEndOf="@id/tvIpLabel" />

    <TextView
        android:id="@+id/tvPortLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Port: "
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvIpLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8080"
        app:layout_constraintTop_toTopOf="@id/tvPortLabel"
        app:layout_constraintStart_toEndOf="@id/tvPortLabel" />

    <TextView
        android:id="@+id/tvSentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Sent: "
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPortLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSentCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintTop_toTopOf="@id/tvSentLabel"
        app:layout_constraintStart_toEndOf="@id/tvSentLabel" />

    <TextView
        android:id="@+id/tvPublicUrlLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Public URL (ngrok):"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSentLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etPublicUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://xyz.ngrok-free.app"
        android:textSize="14sp"
        android:inputType="textUri"
        app:layout_constraintTop_toBottomOf="@id/tvPublicUrlLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start Gateway"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etPublicUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnStop"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Stop Gateway"
        android:enabled="false"
        app:layout_constraintTop_toTopOf="@id/btnStart"
        app:layout_constraintStart_toEndOf="@id/btnStart"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnTestSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test SMS"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnStart" />

    <TextView
        android:id="@+id/tvLogsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logs:"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnTestSms"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#EEEEEE"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogsLabel"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Logs will appear here..."
            android:textSize="12sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
